---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../utils/paths';
import siteConfig from '../../config/site';
import {
  ShieldAlert,
  AlertTriangle,
  Flame,
  History,
  LifeBuoy,
  CheckCircle2,
  XCircle,
  HelpCircle,
  ArrowRight,
  ExternalLink,
  Sparkles,
} from 'lucide-astro';

// 历史典型跑路阵亡档案库（客观复盘吸取教训）
const graveyardList = [
  {
    name: '速鹰666 / 夜莺云系',
    period: '2020 - 2023',
    cause: '恶性超售导致骨干网成本倒挂，通过换皮开新站持续割韭菜，最终全线失联。',
    lesson: '警惕拥有数十个“同款换皮姐妹站”的低价矩阵，一家出事全线崩盘。',
  },
  {
    name: '速蛙云 (FastFrog)',
    period: '2019 - 2022',
    cause: '大规模炒作超低价三年付与终身包，资金盘击鼓传花破裂，创始人卷款跑路。',
    lesson: '永远不碰“三年付只要几十元”的资金盘，违背基础网络带宽成本的必死无疑。',
  },
  {
    name: '喵帕斯 (SS-Neko)',
    period: '2017 - 2020',
    cause: '国内入口机房遭遇突发不可抗力安全通报，资金链断裂且无异地灾备体系。',
    lesson: '必须选择具备多地多入口 BGP 容灾架构的老牌机场，单点入口风险极高。',
  },
  {
    name: '布丁网络 (Pudding)',
    period: '2021 - 2024',
    cause: '上游专线 IDC 欠费被强行拔线，官方 Telegram 群开启禁言后注销。',
    lesson: 'TG 群组突然关闭评论或全员禁言，是进入跑路倒计时的最准危险信号。',
  },
];

// 跑路预警评级状态
const alertLevels = [
  {
    level: '🔴 已确认跑路 (Defunct)',
    color: 'border-rose-500/40 bg-rose-500/10 text-rose-300',
    desc: '官网彻底打不开、节点全红超时超过 7 天、Telegram 官方频道与客服全部注销失联。',
    action: '停止任何支付尝试，立即在客户端中删除订阅，切换备用机场。',
  },
  {
    level: '🟠 高危警报 (High Risk)',
    color: 'border-amber-500/40 bg-amber-500/10 text-amber-300',
    desc: '官方群开启全员禁言、工单系统关闭、突然狂推反常的超低价骨折年付（集中收割）。',
    action: '切勿继续续费，立即导出本地配置，备份重要数据与网络节点。',
  },
  {
    level: '🟡 观察期 (Under Watch)',
    color: 'border-yellow-500/40 bg-yellow-500/10 text-yellow-300',
    desc: '因国内入口机房突发网络割接或敏感期上游维护，部分节点出现临时不可用。',
    action: '保持观察，使用按量付费备用节点过渡，避免情绪化操作。',
  },
  {
    level: '🟢 稳定运营 (Normal Status)',
    color: 'border-emerald-500/40 bg-emerald-500/10 text-emerald-300',
    desc: 'BGP 多入口冗余正常，晚高峰丢包率低于 1%，官方公告与工单响应及时。',
    action: '跑机场已收录的 42 家主流品牌均处于该基准线追踪监控中。',
  },
];
---

<BaseLayout
  title="全网机场跑路预警情报局 | 阵亡名单复盘、跑路征兆识别与自救指南 — 跑机场"
  description="跑机场评测实验室独立监控：全网科学上网机场跑路预警情报局。收录历史阵亡公墓名单复盘、跑路前五大典型异常特征、被割韭菜后的紧急止损与备用节点自救全攻略。"
>
  <!-- Hero Header -->
  <div class="mb-10 p-7 sm:p-10 lg:p-12 liquid-glass rounded-3xl shadow-xl relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(239,68,68,0.22),rgba(245,158,11,0.12)_35%,transparent_65%)] pointer-events-none rounded-3xl"></div>

    <div class="relative z-10 max-w-3xl">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-300 border border-rose-400/20 mb-3">
        <ShieldAlert class="w-3.5 h-3.5 text-rose-400" />
        网络避坑与跑路情报雷达 (Alert Radar)
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-zinc-50 tracking-tight leading-tight mb-4">
        2026 机场跑路预警情报局与阵亡公墓档案
      </h1>

      <p class="text-sm sm:text-base text-zinc-300 leading-relaxed mb-6">
        在这个缺乏行业准入标准的灰色地带，跑路与卷款从未止息。跑机场成立情报专栏，以客观数据追踪全网服务商运营健康度，曝光资金盘收割套路，为广大用户提供最坚固的安全防火墙。
      </p>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="#levels"
          class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-xs font-semibold text-white transition-all flex items-center gap-1.5"
        >
          <span>跑路预警四级响应标准</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
        <a
          href="#graveyard"
          class="px-4 py-2 rounded-full bg-white/10 hover:bg-white/20 text-xs font-semibold text-white transition-all flex items-center gap-1.5"
        >
          <span>历史阵亡公墓档案</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
        <a
          href="#emergency"
          class="px-4 py-2 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 text-xs font-semibold transition-all flex items-center gap-1.5"
        >
          <LifeBuoy class="w-3.5 h-3.5" />
          <span>断网失联紧急自救手册</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Section 1: Alert Levels Definition -->
  <section id="levels" class="my-10 p-6 sm:p-8 liquid-glass rounded-3xl shadow-xl border border-white/10">
    <div class="max-w-2xl mb-6">
      <h2 class="text-xl font-bold text-white mb-2">
        跑机场预警雷达：四级运营状态响应矩阵
      </h2>
      <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed">
        当手中正在使用的机场出现网络异常时，请对照以下四级标准判断其危险性，并采取相应防御措施：
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {alertLevels.map((item) => (
        <div class={`p-5 rounded-2xl border ${item.color} transition-all`}>
          <div class="font-bold text-base mb-2">
            {item.level}
          </div>
          <p class="text-xs text-zinc-300 leading-relaxed mb-3">
            {item.desc}
          </p>
          <div class="pt-2 border-t border-white/10 text-xs font-mono text-zinc-400">
            <strong>建议应对措施：</strong>{item.action}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 2: 5 Classical Symptoms Before Collapse -->
  <section class="my-10 p-6 sm:p-8 liquid-glass rounded-3xl shadow-xl border border-white/10">
    <div class="flex items-center gap-3 border-b border-white/10 pb-4 mb-6">
      <Flame class="w-6 h-6 text-amber-400" />
      <div>
        <h2 class="text-xl font-bold text-white">
          深度拆解：劣质机场跑路前的“五步连环收割法”
        </h2>
        <span class="text-xs text-zinc-400 font-mono">从资金链断裂到彻底失联的完整剧本</span>
      </div>
    </div>

    <div class="space-y-4 text-xs sm:text-sm text-zinc-300 leading-relaxed">
      <div class="p-4 rounded-2xl bg-white/5 border border-white/5">
        <h3 class="text-sm font-bold text-amber-400 mb-1">
          第 1 步：恶性超售导致骨干网成本倒挂
        </h3>
        <p class="text-zinc-400 leading-relaxed">
          前期通过低价引流，数万名用户涌入有限的公网入口。到了晚高峰，带宽成本激增，站长开始入不敷出。此时站长不会选择扩容，而是选择限制用户连接数并调高节点倍率。
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-white/5 border border-white/5">
        <h3 class="text-sm font-bold text-amber-400 mb-1">
          第 2 步：节点大面积红片与“甩锅上游”
        </h3>
        <p class="text-zinc-400 leading-relaxed">
          机房开始欠费，部分出口服务器被停机。官方公告开始频繁发布“因上游光缆被挖断”、“不可抗力网络抖动”、“正在通宵割接”等虚假借口安抚用户。
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-white/5 border border-white/5">
        <h3 class="text-sm font-bold text-rose-400 mb-1">
          第 3 步：推出骨折级年付甩卖（致命陷阱！）
        </h3>
        <p class="text-zinc-400 leading-relaxed">
          这是跑路前最关键的标志性动作！站长明知无法维持运营，突然在网站弹出“周年庆限时特惠：充一年送两年”、“永久不限时 29.9 元买断”，试图在关站前再卷走最后一批资金池。
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-white/5 border border-white/5">
        <h3 class="text-sm font-bold text-rose-400 mb-1">
          第 4 步：官方社群开启禁言并踢出活跃质疑者
        </h3>
        <p class="text-zinc-400 leading-relaxed">
          随着节点彻底瘫痪，群内维权声浪四起。管理团队开启全员禁言，关闭工单回复，踢出所有带节奏和发测速图的用户。
        </p>
      </div>

      <div class="p-4 rounded-2xl bg-white/5 border border-white/5">
        <h3 class="text-sm font-bold text-rose-400 mb-1">
          第 5 步：清空频道注销跑路（或者换皮重开）
        </h3>
        <p class="text-zinc-400 leading-relaxed">
          彻底删除数据库与 Telegram 频道，卷款离场。有的甚至换一个新域名、换一套 UI 模板，重新上线继续割下一批韭菜。
        </p>
      </div>
    </div>
  </section>

  <!-- Section 3: Defunct Graveyard (Historical Archive) -->
  <section id="graveyard" class="my-10 p-6 sm:p-8 liquid-glass rounded-3xl shadow-xl border border-white/10">
    <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
      <div class="flex items-center gap-3">
        <History class="w-6 h-6 text-zinc-400" />
        <div>
          <h2 class="text-xl font-bold text-white">
            阵亡公墓：全网知名大型机场跑路案例深度复盘
          </h2>
          <span class="text-xs text-zinc-400 font-mono">前事不忘，后事之师 · 拒绝重蹈覆辙</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {graveyardList.map((item) => (
        <div class="p-5 rounded-2xl bg-black/40 border border-white/10 relative overflow-hidden">
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-white text-base">{item.name}</span>
            <span class="text-xs px-2 py-0.5 rounded-full bg-white/10 text-zinc-400 font-mono">{item.period}</span>
          </div>
          <p class="text-xs text-zinc-300 mb-3 leading-relaxed">
            <strong>阵亡复盘：</strong>{item.cause}
          </p>
          <div class="p-3 rounded-xl bg-white/5 text-xs text-amber-300 font-mono">
            <strong>警示启示：</strong>{item.lesson}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Section 4: Emergency Self-Rescue Protocol -->
  <section id="emergency" class="my-10 p-6 sm:p-8 liquid-glass rounded-3xl shadow-xl border border-indigo-500/30">
    <div class="flex items-center gap-3 border-b border-white/10 pb-4 mb-6">
      <LifeBuoy class="w-6 h-6 text-indigo-400" />
      <div>
        <h2 class="text-xl font-bold text-white">
          紧急自救：被割韭菜或主力断网后的 3 步应急指南
        </h2>
        <span class="text-xs text-zinc-400 font-mono">无论发生何种变故，确保生产力 3 分钟内恢复</span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs sm:text-sm">
      <div class="p-5 rounded-2xl bg-white/5 border border-white/10">
        <span class="w-6 h-6 rounded-full bg-indigo-500/20 text-indigo-300 flex items-center justify-center font-bold text-xs mb-3">1</span>
        <h3 class="text-white font-bold mb-2">清理失效订阅与本地网卡</h3>
        <p class="text-zinc-400 leading-relaxed">
          立即在 Clash Verge 或小火箭中关闭 TUN 模式，删除失效机场的订阅链接，避免无效轮询占用 CPU 算力或引发网卡循环路由冲突。
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-white/5 border border-white/10">
        <span class="w-6 h-6 rounded-full bg-indigo-500/20 text-indigo-300 flex items-center justify-center font-bold text-xs mb-3">2</span>
        <h3 class="text-white font-bold mb-2">激活按量付费备用节点池</h3>
        <p class="text-zinc-400 leading-relaxed">
          平时务必在本地备好一份永久不过期的不限时按量流量包（如光速云 147 永久套餐）。关键时刻直接启用，免去重新调研付款的慌乱。
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-white/5 border border-white/10">
        <span class="w-6 h-6 rounded-full bg-indigo-500/20 text-indigo-300 flex items-center justify-center font-bold text-xs mb-3">3</span>
        <h3 class="text-white font-bold mb-2">参考独立天梯榜重选老牌</h3>
        <p class="text-zinc-400 leading-relaxed">
          前往 <a href={url('/#top10')} class="text-indigo-400 underline">跑机场 42 家综合天梯榜</a>，筛选持续运营 2 年以上、具备 BGP 冗余专线的老牌服务商，坚持小额月付重建信心。
        </p>
      </div>
    </div>
  </section>

  <!-- Cross-link Related Content -->
  <div class="my-16 p-8 liquid-glass rounded-3xl border border-indigo-500/30 text-center relative overflow-hidden shadow-2xl">
    <div class="relative z-10 max-w-xl mx-auto space-y-4">
      <h3 class="text-2xl font-black text-white">
        选择稳健老牌，远离跑路梦魇
      </h3>
      <p class="text-xs sm:text-sm text-zinc-300">
        跑机场已对全网 42 家主流品牌完成全维度实测建档，晚高峰丢包与解锁全量可查。
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a
          href={url('/airports')}
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 text-white font-bold text-xs sm:text-sm shadow-xl hover:scale-105 transition-all"
        >
          <span>进入 42 家机场品牌大厅</span>
          <ArrowRight class="w-4 h-4" />
        </a>
        <a
          href={url('/blog/02-airport-selection-guide-2026')}
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-full liquid-pill hover:border-indigo-400/40 text-zinc-200 font-bold text-xs sm:text-sm hover:scale-105 transition-all"
        >
          <span>阅读防跑路避坑专栏</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
