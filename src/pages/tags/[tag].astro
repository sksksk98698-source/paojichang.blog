---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/ui/PostCard.astro';
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { getCollection } from 'astro:content';
import { ArrowLeft } from 'lucide-astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const tags = [...new Set(allPosts.flatMap((p) => p.data.tags || []))];

  return tags.map((tag) => {
    const filteredPosts = allPosts.filter((p) =>
      p.data.tags?.some((t: string) => t.toLowerCase() === tag.toLowerCase())
    ).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { tag: tag.toLowerCase() },
      props: { tag, posts: filteredPosts },
    };
  });
}

const { tag, posts } = Astro.props;
---

<BaseLayout
  title={`#${tag} 标签相关文章 — ${siteConfig.name}`}
  description={`探索包含 #${tag} 标签的技术博客、实战指南与深度解析。跑机场网络实验室权威梳理相关协议、避坑指南与实操手册。`}
  noindex={posts.length < 3}
>
  <div class="mb-6">
    <a
      href={url('/tags')}
      class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-zinc-400 hover:text-indigo-400 transition-colors"
    >
      <ArrowLeft class="w-3.5 h-3.5" />
      <span>返回所有标签</span>
    </a>
  </div>

  <div class="mb-10 p-7 sm:p-10 liquid-glass rounded-3xl shadow-xl">
    <div class="flex items-center justify-between">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-300 border border-indigo-400/20 mb-2.5">
          标签聚合与实战指南
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-50 tracking-tight">
          #{tag}
        </h1>
        <p class="text-sm text-zinc-300 mt-2 max-w-2xl leading-relaxed">
          收录跑机场网络实验室围绕 <strong>#{tag}</strong> 展开的深度实测报告与操作指南。包含网络底层传输架构分析、流媒体与 ChatGPT 原生解锁技巧及防跑路避坑经验。
        </p>
      </div>

      <div class="hidden sm:block">
        <span class="font-mono text-3xl text-zinc-700 font-bold">
          #{tag.toUpperCase()}
        </span>
      </div>
    </div>

    <div class="mt-6 pt-6 border-t border-white/10 flex flex-wrap items-center gap-3 text-xs">
      <span class="text-zinc-400">快速导航：</span>
      <a href={url('/airports')} class="text-indigo-300 hover:text-white underline">42家机场品牌库</a>
      <span class="text-zinc-600">·</span>
      <a href={url('/speedtest')} class="text-cyan-300 hover:text-white underline">测速实测大厅</a>
      <span class="text-zinc-600">·</span>
      <a href={url('/faq')} class="text-emerald-300 hover:text-white underline">机场百科全书</a>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {posts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</BaseLayout>
