---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { getCollection } from 'astro:content';
import { Tag } from 'lucide-astro';

const allPosts = await getCollection('blog');
const tags = [...new Set(allPosts.flatMap((p) => p.data.tags || []))];

const tagsWithCount = tags.map((tag) => ({
  name: tag,
  count: allPosts.filter((p) => p.data.tags?.includes(tag)).length,
})).sort((a, b) => b.count - a.count);
---

<BaseLayout
  title={`标签索引与探索 — ${siteConfig.name}`}
  description="按具体技术栈、工具与工程话题检索技术博客与开发笔记。"
>
  <div class="mb-10 p-7 sm:p-10 liquid-glass rounded-3xl shadow-xl">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-300 border border-indigo-400/20 mb-2.5">
      <Tag class="w-3.5 h-3.5" />
      技术标签索引
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-50 tracking-tight">
      标签云全览
    </h1>
    <p class="text-sm text-zinc-400 mt-2">
      精准定位特定工具、框架、协议以及工程模式相关的专题内容。
    </p>
  </div>

  <div class="p-7 sm:p-10 liquid-glass rounded-3xl shadow-xl">
    <div class="flex flex-wrap gap-3">
      {tagsWithCount.map((tag) => (
        <a
          href={url(`/tags/${encodeURIComponent(tag.name.toLowerCase())}`)}
          class="flex items-center gap-2 px-4 py-2 rounded-full liquid-pill hover:scale-105 hover:border-indigo-400/40 transition-all text-xs sm:text-sm font-medium"
        >
          <span class="text-indigo-400 font-mono text-xs font-semibold">#</span>
          <span class="text-zinc-200">{tag.name}</span>
          <span class="ml-1 px-2 py-0.5 text-[11px] bg-white/10 text-zinc-300 font-mono rounded-full">
            {tag.count}
          </span>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
