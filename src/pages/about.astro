---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpeechBubble from '../components/mdx/SpeechBubble.astro';
import siteConfig from '../config/site';
import { url } from '../utils/paths';
import { Sparkles, Github, Twitter, Linkedin, Mail } from 'lucide-astro';

const aboutData = siteConfig.about;

const techArsenal = aboutData?.techArsenal || [
  { name: 'Astro 7', desc: 'Islands architecture, server islands, and zero-JS defaults', category: 'Framework' },
  { name: 'TypeScript', desc: 'Strict domain models, algebraic types, and nominal branding', category: 'Language' },
  { name: 'Tailwind CSS 4', desc: 'Liquid Glass design system, modern gradients & CSS tokens', category: 'Styling' },
  { name: 'Vite & Pagefind', desc: 'Instant hot-reloading and lightning-fast static indexing', category: 'Tooling' },
  { name: 'Edge Runtimes', desc: 'Distributed low-latency deployment at the CDN edge', category: 'Infra' },
  { name: 'Modern SEO', desc: 'Schema.org structured data and web standards', category: 'SEO' },
];

const highlights = aboutData?.highlights || [
  {
    icon: '⚡',
    title: '极速响应 & Zero-JS',
    desc: '全站采用静态预编译交付，首屏极致加载，无需客户端臃肿运行时。',
  },
  {
    icon: '✨',
    title: 'Liquid Glass 界面美学',
    desc: '流体毛玻璃质感、通透高光与 GPU 硬件加速的视觉拟态体验。',
  },
  {
    icon: '🛡️',
    title: '类型严苛与架构稳健',
    desc: '借助 TypeScript 严格静态检查与高内聚领域划分，消灭运行时异常。',
  },
  {
    icon: '🚀',
    title: '全球节点就近分发',
    desc: '依托现代化边缘分发网络，毫秒级响应全球各区域的请求与交互。',
  },
];

const philosophyTitle = aboutData?.philosophyTitle || '站点设计与工程哲学';
const philosophyParagraphs = aboutData?.philosophyParagraphs || [
  'PAOJICHANG.BLOG 诞生于对极致连接速度与极简代码的追求。网络与软件的本质是顺畅无碍地连接人与信息，减少不必要的中间损耗。',
  '在框架日益繁重、资源肆意膨胀的时代，我们坚持内容优先与零客户端 JS 默认交付，以毫秒级的响应速度与通透的毛玻璃触感，呈现最纯粹的技术阅读体验。',
];
const quote = aboutData?.quote || '削减每一毫秒的 TTFB 延迟与多余的运行时开销，让每一次访问都轻快如风。';
---

<BaseLayout
  title={`关于本站 — ${siteConfig.name}`}
  description={`了解 ${siteConfig.name} 的建站哲学、技术架构栈与数字化实践空间。`}
>
  <!-- Page Header with Author Photo -->
  <div class="mb-10 p-8 sm:p-12 liquid-glass rounded-3xl shadow-xl relative overflow-hidden group">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,rgba(99,102,241,0.2),rgba(6,182,212,0.1)_35%,transparent_65%)] pointer-events-none rounded-3xl"></div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center relative z-10">
      <div class="md:col-span-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-300 border border-indigo-400/20 mb-3.5">
          <Sparkles class="w-3.5 h-3.5" />
          关于本站
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-zinc-50 tracking-tight mb-4">
          探索独立工程与技术花园
        </h1>
        <p class="text-base sm:text-lg text-zinc-300 font-normal leading-relaxed">
          你好！这里是 <strong class="text-white font-semibold">{siteConfig.author.name}</strong> 维护的独立技术专栏。{siteConfig.author.bio}
        </p>
      </div>

      <div class="md:col-span-4 flex justify-center md:justify-end">
        <div class="relative group/avatar">
          <div class="absolute -inset-1.5 bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 rounded-3xl blur-md opacity-40 group-hover/avatar:opacity-75 transition duration-500"></div>
          <img
            src={url(siteConfig.author.avatar)}
            alt={siteConfig.author.name}
            class="relative w-36 h-36 sm:w-44 sm:h-44 rounded-3xl object-cover border-2 border-white/20 shadow-2xl"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Main Story Section -->
  <section class="my-10 liquid-glass rounded-3xl shadow-xl p-7 sm:p-10 overflow-hidden">
    <div class="flex items-center gap-2.5 border-b border-white/10 pb-4 mb-6">
      <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-r from-cyan-400 to-indigo-500"></span>
      <h2 class="text-xl font-bold text-zinc-50">
        {philosophyTitle}
      </h2>
    </div>

    <div class="prose prose-zinc dark:prose-invert max-w-none text-zinc-300 space-y-4 leading-relaxed text-sm sm:text-base">
      {philosophyParagraphs.map((p) => (
        <p>{p}</p>
      ))}
    </div>

    <div class="my-8">
      <SpeechBubble speaker={siteConfig.author.name} role={siteConfig.author.role} avatar="⚡" side="left">
        "{quote}"
      </SpeechBubble>
    </div>
  </section>

  <!-- Core Pillars -->
  <section class="my-12">
    <div class="flex items-center gap-2.5 border-b border-white/10 pb-4 mb-8">
      <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-r from-indigo-500 to-purple-500"></span>
      <h2 class="text-2xl font-bold text-zinc-50">
        核心关注维度
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {highlights.map((item) => (
        <div class="p-7 liquid-glass-card rounded-3xl shadow-lg flex flex-col justify-between overflow-hidden">
          <div>
            <div class="w-12 h-12 rounded-full liquid-pill flex items-center justify-center text-2xl shadow-md mb-4">
              {item.icon}
            </div>

            <h3 class="text-lg font-bold text-zinc-50 mb-2">
              {item.title}
            </h3>

            <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed">
              {item.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Technology Stack & Tools -->
  <section class="my-12 p-7 sm:p-10 liquid-glass rounded-3xl shadow-xl overflow-hidden">
    <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-6">
      <div class="flex items-center gap-2.5">
        <span class="w-2.5 h-2.5 rounded-full bg-gradient-to-r from-amber-400 to-rose-500"></span>
        <h2 class="text-lg font-bold text-zinc-50">
          技术武器库
        </h2>
      </div>
      <span class="text-xs font-mono text-zinc-400">CORE TECH ARSENAL</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {techArsenal.map((tech) => (
        <div class="p-5 rounded-2xl liquid-glass-card flex flex-col justify-between shadow-xs">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-sm font-bold text-zinc-100">
                {tech.name}
              </span>
              <span class="px-2.5 py-0.5 rounded-full liquid-pill text-indigo-300 text-[10px] font-mono font-semibold">
                {tech.category}
              </span>
            </div>
            <p class="text-xs text-zinc-400 leading-relaxed">
              {tech.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Connect & Socials -->
  <section class="my-12 p-8 sm:p-10 liquid-glass rounded-3xl shadow-xl relative overflow-hidden group text-center sm:text-left">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
      <div class="md:col-span-8 space-y-2">
        <h3 class="text-2xl font-extrabold text-zinc-50 tracking-tight">
          交流探讨与技术联络
        </h3>
        <p class="text-sm text-zinc-300 max-w-xl leading-relaxed">
          欢迎交流全球网络优化、边缘架构设计与现代 Web 性能话题。
        </p>
      </div>

      <div class="md:col-span-4 flex flex-wrap justify-center md:justify-end gap-3">
        {siteConfig.author.social.github && (
          <a
            href={siteConfig.author.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-5 py-3 rounded-full bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 hover:from-cyan-400 hover:via-indigo-500 hover:to-purple-500 text-white text-xs font-semibold shadow-lg shadow-indigo-500/25 hover:scale-[1.02] active:scale-[0.98] transition-all"
          >
            <Github class="w-4 h-4" />
            <span>GitHub</span>
          </a>
        )}

        {siteConfig.author.social.twitter && (
          <a
            href={siteConfig.author.social.twitter}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-5 py-3 rounded-full liquid-pill hover:border-indigo-400/40 text-xs font-semibold text-zinc-200 hover:scale-[1.02] transition-all"
          >
            <Twitter class="w-4 h-4" />
            <span>Twitter / X</span>
          </a>
        )}

        {siteConfig.author.social.linkedin && (
          <a
            href={siteConfig.author.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 px-5 py-3 rounded-full liquid-pill hover:border-indigo-400/40 text-xs font-semibold text-zinc-200 hover:scale-[1.02] transition-all"
          >
            <Linkedin class="w-4 h-4" />
            <span>LinkedIn</span>
          </a>
        )}

        {siteConfig.author.social.email && (
          <a
            href={`mailto:${siteConfig.author.social.email}`}
            class="flex items-center gap-2 px-5 py-3 rounded-full liquid-pill hover:border-indigo-400/40 text-xs font-semibold text-zinc-200 hover:scale-[1.02] transition-all"
          >
            <Mail class="w-4 h-4" />
            <span>邮件联系</span>
          </a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
