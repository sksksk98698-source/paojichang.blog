<script>
  function setupSingleCopy() {
    const btn = document.querySelector('.single-copy-code-btn');
    if (!btn) return;

    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      const code = btn.getAttribute('data-code');
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        const copyIcon = btn.querySelector('.copy-icon');
        const checkIcon = btn.querySelector('.check-icon');
        const statusText = btn.querySelector('.btn-status');

        copyIcon?.classList.add('hidden');
        checkIcon?.classList.remove('hidden');
        if (statusText) statusText.textContent = '(已复制到剪贴板)';

        setTimeout(() => {
          copyIcon?.classList.remove('hidden');
          checkIcon?.classList.add('hidden');
          if (statusText) statusText.textContent = '(点击复制)';
        }, 2000);
      } catch (err) {
        console.error(err);
      }
    });
  }

  setupSingleCopy();
  document.addEventListener('astro:after-swap', setupSingleCopy);
</script>
