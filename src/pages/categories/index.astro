---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { getCollection } from 'astro:content';
import { ArrowRight, Layers } from 'lucide-astro';

const allPosts = await getCollection('blog');

const categories = siteConfig.categories;

const categoryList = categories.map((cat) => ({
  ...cat,
  posts: allPosts.filter((p) => p.data.category.toLowerCase() === cat.name.toLowerCase()),
}));
---

<BaseLayout
  title={`探索核心技术分类 — ${siteConfig.name}`}
  description="按技术维度整理的文章合集、架构模式与工程实践。"
>
  <div class="mb-10 p-7 sm:p-10 liquid-glass rounded-3xl shadow-xl">
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-300 border border-indigo-400/20 mb-2.5">
      <Layers class="w-3.5 h-3.5" />
      技术专栏与领域
    </div>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-50 tracking-tight">
      分类主题归档
    </h1>
    <p class="text-sm text-zinc-400 mt-2">
      选择您感兴趣的技术方向，探索高可用网络系统、现代全栈与界面美学实践。
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {categoryList.map((cat) => (
      <a
        href={url(`/categories/${cat.name.toLowerCase()}`)}
        class="group p-7 rounded-3xl liquid-glass-card shadow-lg hover:scale-[1.02] transition-all flex flex-col justify-between"
      >
        <div>
          <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
            <h2 class="text-xl font-bold text-zinc-50 group-hover:text-indigo-400 transition-colors">
              {cat.name}
            </h2>
            <span class="w-8 h-8 rounded-full liquid-pill flex items-center justify-center font-mono text-xs font-bold text-indigo-300">
              {cat.posts.length}
            </span>
          </div>

          <p class="text-sm text-zinc-300 mb-6 leading-relaxed">
            {cat.desc}
          </p>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-white/10 text-xs font-semibold text-indigo-400">
          <span>阅读专栏文章</span>
          <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
