---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/ui/PostCard.astro';
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { getCollection } from 'astro:content';
import { ArrowLeft } from 'lucide-astro';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const configuredCategories = siteConfig.categories.map((c) => c.name.toLowerCase());
  const postCategories = allPosts.map((p) => p.data.category.toLowerCase());
  const categories = [...new Set([...configuredCategories, ...postCategories])];

  return categories.map((cat) => {
    const filteredPosts = allPosts.filter(
      (p) => p.data.category.toLowerCase() === cat.toLowerCase()
    ).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    return {
      params: { category: cat },
      props: { category: cat, posts: filteredPosts },
    };
  });
}

const { category, posts } = Astro.props;
const categoryTitle = category.charAt(0).toUpperCase() + category.slice(1);
---

<BaseLayout
  title={`${categoryTitle} 技术专栏 — ${siteConfig.name}`}
  description={`浏览 ${categoryTitle} 领域的高性能架构与前沿技术实战文章。跑机场评测实验室权威梳理核心网络原理、分流规则与避坑经验。`}
  noindex={posts.length < 3}
>
  <div class="mb-6">
    <a
      href={url('/categories')}
      class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-zinc-400 hover:text-indigo-400 transition-colors"
    >
      <ArrowLeft class="w-3.5 h-3.5" />
      <span>返回所有分类</span>
    </a>
  </div>

  <div class="mb-10 p-7 sm:p-10 liquid-glass rounded-3xl shadow-xl">
    <div class="flex items-center justify-between">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-300 border border-indigo-400/20 mb-2.5">
          专题分类
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-50 tracking-tight">
          {categoryTitle}
        </h1>
        <p class="text-sm text-zinc-300 mt-2 max-w-2xl leading-relaxed">
          {categoryTitle} 专栏聚合了跑机场评测实验室围绕跨境网络传输、科学上网客户端进阶与流媒体 AI 原生解锁编写的深度笔记。
        </p>
      </div>
    </div>

    <div class="mt-6 pt-6 border-t border-white/10 flex flex-wrap items-center gap-3 text-xs">
      <span class="text-zinc-400">专题导流：</span>
      <a href={url('/airports')} class="text-indigo-300 hover:text-white underline">42家机场品牌库</a>
      <span class="text-zinc-600">·</span>
      <a href={url('/speedtest')} class="text-cyan-300 hover:text-white underline">测速实测大厅</a>
      <span class="text-zinc-600">·</span>
      <a href={url('/free')} class="text-purple-300 hover:text-white underline">免费资源专区</a>
    </div>
  </div>

  {posts.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {posts.map((post) => (
        <PostCard post={post} />
      ))}
    </div>
  ) : (
    <div class="p-12 text-center liquid-glass rounded-3xl">
      <p class="text-sm text-zinc-400">当前该分类下暂无已发布的文章。</p>
    </div>
  )}
</BaseLayout>
