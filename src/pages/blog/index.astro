---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/ui/PostCard.astro';
import siteConfig from '../../config/site';
import { url } from '../../utils/paths';
import { getCollection } from 'astro:content';
import { Layers } from 'lucide-astro';

const allPosts = await getCollection('blog');
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['全部', ...siteConfig.categories.map((c) => c.name)];
---

<BaseLayout
  title={`科学上网技术指南与网络工程笔记 — ${siteConfig.name}`}
  description="跑机场网络实战博客专栏：收录 IEPL/IPLC 跨境网络传输原理剖析、2026 科学上网防踩坑避雷手册、ChatGPT/Netflix 住宅 IP 原生解锁及 Clash Verge Rev TUN 模式进阶调优全卷。"
>
  <!-- Page Header -->
  <div class="mb-10 p-7 sm:p-10 liquid-glass rounded-3xl shadow-xl">
    <div class="flex flex-wrap items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-300 border border-indigo-400/20 mb-2.5">
          <Layers class="w-3.5 h-3.5" />
          技术专栏与精选
        </div>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-50 tracking-tight">
          全部文章归档
        </h1>
        <p class="text-sm text-zinc-400 mt-2">
          累计发表技术解析：<strong class="text-zinc-100 font-mono font-semibold">{sortedPosts.length}</strong> 篇
        </p>
      </div>

      <!-- Category Filter Pills -->
      <div class="flex flex-wrap gap-2">
        {categories.map((category) => (
          <a
            href={category === '全部' ? url('/blog') : url(`/categories/${category.toLowerCase()}`)}
            class:list={[
              'px-4 py-2 text-xs font-semibold rounded-full transition-all',
              category === '全部'
                ? 'bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 text-white shadow-md shadow-indigo-500/25'
                : 'liquid-pill text-zinc-300 hover:text-indigo-300',
            ]}
          >
            {category}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Articles Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {sortedPosts.map((post) => (
      <PostCard post={post} />
    ))}
  </div>
</BaseLayout>
