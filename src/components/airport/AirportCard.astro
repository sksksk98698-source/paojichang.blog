---
import type { AirportData } from '../../data/airports';
import { url } from '../../utils/paths';
import { Zap, ShieldCheck, ArrowRight, ExternalLink, Check, Copy, Sparkles } from 'lucide-astro';

interface Props {
  airport: AirportData;
}

const { airport } = Astro.props;
const detailUrl = url(`/airports/${airport.slug}`);
const isTop1 = airport.rank === 1;
---

<div
  class:list={[
    'relative flex flex-col justify-between rounded-3xl p-6 sm:p-7 shadow-lg transition-all duration-300 group overflow-hidden',
    isTop1
      ? 'liquid-glass ring-2 ring-indigo-500/50 shadow-indigo-500/10'
      : 'liquid-glass-card hover:scale-[1.01] hover:border-indigo-400/30',
  ]}
  data-airport-card
  data-name={airport.name}
  data-linetype={airport.lineType}
  data-price={airport.minPriceNum}
  data-tags={airport.tags.join(',')}
>
  <!-- Top glow for Top 1 -->
  {isTop1 && (
    <div class="absolute -top-12 -right-12 w-48 h-48 bg-gradient-to-br from-cyan-400/20 via-indigo-500/25 to-purple-600/20 blur-2xl pointer-events-none rounded-full"></div>
  )}

  <div>
    <!-- Top Row: Rank Badge + Line Type + Operational year -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <div class="flex items-center gap-2">
        <span
          class:list={[
            'inline-flex items-center justify-center font-mono font-bold text-xs px-2.5 py-0.5 rounded-full shadow-xs',
            airport.rank === 1
              ? 'bg-gradient-to-r from-amber-400 to-amber-600 text-slate-950 font-black'
              : airport.rank === 2
              ? 'bg-slate-200 text-slate-950 font-bold'
              : airport.rank === 3
              ? 'bg-amber-700/60 text-amber-200'
              : 'liquid-pill text-zinc-400',
          ]}
        >
          #{airport.rank}
        </span>

        {isTop1 && (
          <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-gradient-to-r from-cyan-500/20 to-indigo-500/20 text-indigo-300 border border-indigo-400/30">
            <Sparkles class="w-3 h-3 text-cyan-400" />
            第一主推
          </span>
        )}

        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-300 border border-indigo-400/20">
          {airport.lineType}
        </span>
      </div>

      <div class="text-xs text-zinc-400 font-mono">
        {airport.operationalSince ? `${airport.operationalSince}运营` : '多节点实测'}
      </div>
    </div>

    <!-- Airport Name & Starting Price -->
    <div class="flex items-start justify-between gap-3 mb-2">
      <h3 class="text-xl sm:text-2xl font-black text-zinc-50 tracking-tight group-hover:text-indigo-400 transition-colors">
        <a href={detailUrl} class="focus:outline-none">
          {airport.name}
        </a>
      </h3>

      <div class="text-right shrink-0">
        <div class="text-xs text-zinc-400 font-medium">入门起步</div>
        <div class="text-base sm:text-lg font-extrabold text-emerald-400 font-mono tracking-tight">
          {airport.minPrice}
        </div>
      </div>
    </div>

    <!-- Highlights Pill List -->
    <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed mb-4 line-clamp-2">
      {airport.highlights[0]}。{airport.highlights[1] || ''}
    </p>

    <!-- Key Attributes Grid -->
    <div class="grid grid-cols-2 gap-2 mb-4 p-3 rounded-2xl bg-white/5 border border-white/5 text-xs text-zinc-300 font-mono">
      <div class="flex items-center gap-1.5 truncate">
        <Zap class="w-3.5 h-3.5 text-cyan-400 shrink-0" />
        <span class="text-zinc-400">协议:</span>
        <span class="truncate">{airport.protocols.join(', ')}</span>
      </div>
      <div class="flex items-center gap-1.5 truncate">
        <ShieldCheck class="w-3.5 h-3.5 text-indigo-400 shrink-0" />
        <span class="text-zinc-400">流媒体:</span>
        <span class="text-emerald-400 truncate">4K Netflix / AI</span>
      </div>
    </div>

    <!-- Promo Code One-Click Copy Pill (If available) -->
    {airport.promoCode && (
      <div class="flex items-center justify-between gap-2 p-2.5 mb-4 rounded-xl liquid-pill border-dashed border-indigo-400/30 bg-indigo-500/5">
        <div class="flex items-center gap-1.5 text-xs">
          <span class="text-zinc-400">独家优惠码:</span>
          <code class="px-2 py-0.5 rounded-md bg-indigo-500/20 text-indigo-300 font-bold font-mono text-xs">
            {airport.promoCode}
          </code>
        </div>
        <button
          type="button"
          class="copy-code-btn px-2.5 py-1 rounded-lg bg-indigo-600/30 hover:bg-indigo-600/50 text-[11px] font-semibold text-indigo-200 transition-colors flex items-center gap-1 cursor-pointer"
          data-code={airport.promoCode}
        >
          <Copy class="w-3 h-3 copy-icon" />
          <Check class="w-3 h-3 check-icon hidden text-emerald-400" />
          <span class="btn-text">复制</span>
        </button>
      </div>
    )}
  </div>

  <!-- Bottom Action Buttons: Direct Affiliate Register + Full Review -->
  <div class="pt-4 border-t border-white/10 flex items-center gap-2.5">
    <a
      href={airport.affiliateUrl}
      target="_blank"
      rel="nofollow sponsored noopener"
      class="flex-1 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-full bg-gradient-to-r from-cyan-500 via-indigo-600 to-purple-600 hover:from-cyan-400 hover:via-indigo-500 hover:to-purple-500 text-white text-xs font-bold shadow-md shadow-indigo-500/25 hover:scale-[1.02] active:scale-[0.98] transition-all text-center cursor-pointer"
      title={`前往 ${airport.name} 官网注册`}
    >
      <span>直达官网注册</span>
      <ExternalLink class="w-3.5 h-3.5" />
    </a>

    <a
      href={detailUrl}
      class="px-3.5 py-2.5 rounded-full liquid-pill hover:border-indigo-400/40 text-zinc-300 hover:text-indigo-300 text-xs font-semibold flex items-center gap-1 transition-all shrink-0"
      title={`查看 ${airport.name} 深度测评与测速图`}
    >
      <span>实测详情</span>
      <ArrowRight class="w-3.5 h-3.5" />
    </a>
  </div>
</div>

<script>
  function setupCopyButtons() {
    document.querySelectorAll('.copy-code-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        const code = btn.getAttribute('data-code');
        if (!code) return;
        try {
          await navigator.clipboard.writeText(code);
          const copyIcon = btn.querySelector('.copy-icon');
          const checkIcon = btn.querySelector('.check-icon');
          const btnText = btn.querySelector('.btn-text');

          copyIcon?.classList.add('hidden');
          checkIcon?.classList.remove('hidden');
          if (btnText) btnText.textContent = '已复制';

          setTimeout(() => {
            copyIcon?.classList.remove('hidden');
            checkIcon?.classList.add('hidden');
            if (btnText) btnText.textContent = '复制';
          }, 2000);
        } catch (err) {
          console.error(err);
        }
      });
    });
  }

  setupCopyButtons();
  document.addEventListener('astro:after-swap', setupCopyButtons);
</script>
