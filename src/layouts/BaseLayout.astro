---
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import siteConfig from '../config/site';
import { url } from '../utils/paths';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  canonical?: string;
  noindex?: boolean;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = siteConfig.defaultOgImage || '/images/og-default.svg',
  article = false,
  publishedTime,
  modifiedTime,
  tags = [],
  canonical,
  noindex = false,
} = Astro.props;

// Determine clean canonical URL without duplicate trailing slashes
const siteBaseUrl = Astro.site ? Astro.site.toString() : siteConfig.url;
const cleanPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/$/, '');
const canonicalURL = canonical || new URL(cleanPath, siteBaseUrl).href;

const faviconUrl = url(siteConfig.favicon || '/favicon.svg');
const faviconType =
  faviconUrl.endsWith('.svg') || faviconUrl.startsWith('data:image/svg')
    ? 'image/svg+xml'
    : faviconUrl.endsWith('.png')
    ? 'image/png'
    : 'image/x-icon';

const ogImageUrl = image.startsWith('http://') || image.startsWith('https://')
  ? image
  : new URL(url(image), siteBaseUrl).href;

const sitemapUrl = new URL(url('/sitemap-index.xml'), siteBaseUrl).href;
const rssUrl = new URL(url('/rss.xml'), siteBaseUrl).href;

// WebSite Structured Data Schema
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: siteBaseUrl,
  description: siteConfig.description,
  inLanguage: siteConfig.language || 'zh-CN',
  author: {
    '@type': 'Person',
    name: siteConfig.author.name,
    jobTitle: siteConfig.author.role,
    url: siteBaseUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: siteConfig.name,
    url: siteBaseUrl,
    logo: {
      '@type': 'ImageObject',
      url: new URL(faviconUrl, siteBaseUrl).href,
    },
  },
};
---

<!doctype html>
<html lang={siteConfig.language || 'zh-CN'} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#060810" />
    <link rel="icon" type={faviconType} href={faviconUrl} />
    <link rel="apple-touch-icon" href={faviconUrl} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Clean Canonical & Feeds -->
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} RSS Feed`} href={rssUrl} />
    <link rel="sitemap" href={sitemapUrl} />

    <!-- Robots & Crawler Directives -->
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"} />
    <meta name="googlebot" content={noindex ? "noindex, follow" : "index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1"} />
    <meta name="baiduspider" content={noindex ? "noindex, follow" : "index, follow"} />
    <meta name="yisouspider" content={noindex ? "noindex, follow" : "index, follow"} />

    <!-- Domestic & Mobile Search Engine Compatibility (Baidu / UC / Quark) -->
    <meta name="applicable-device" content="pc,mobile" />
    <meta name="format-detection" content="telephone=no" />
    <meta http-equiv="Cache-Control" content="no-transform" />
    <meta http-equiv="Cache-Control" content="no-siteapp" />

    <!-- Search Engine Webmaster Verification Slots (预留官方安全验证通道) -->
    {siteConfig.verification?.google && <meta name="google-site-verification" content={siteConfig.verification.google} />}
    {siteConfig.verification?.bing && <meta name="msvalidate.01" content={siteConfig.verification.bing} />}
    {siteConfig.verification?.shenma && <meta name="shenma-site-verification" content={siteConfig.verification.shenma} />}
    {siteConfig.verification?.baidu && <meta name="baidu-site-verification" content={siteConfig.verification.baidu} />}

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author.name} />

    <!-- Open Graph / Facebook -->
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="zh_CN" />
    {article && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {article && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {article && tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageUrl} />

    <!-- Schema.org WebSite JSON-LD -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

    <slot name="head" />
  </head>
  <body class="relative min-h-screen flex flex-col antialiased selection:bg-indigo-500 selection:text-white overflow-x-hidden">
    <!-- Ambient Fluid Lighting Background Mesh -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_85%_-10%,rgba(56,189,248,0.18),rgba(99,102,241,0.14)_35%,transparent_70%)] dark:bg-[radial-gradient(ellipse_80%_60%_at_85%_-10%,rgba(56,189,248,0.12),rgba(99,102,241,0.16)_40%,transparent_70%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_60%_50%_at_10%_25%,rgba(168,85,247,0.14),rgba(244,63,94,0.06)_40%,transparent_70%)] dark:bg-[radial-gradient(ellipse_60%_50%_at_10%_25%,rgba(129,140,248,0.12),rgba(147,51,234,0.08)_40%,transparent_70%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_50%_80%,rgba(14,165,233,0.1),rgba(99,102,241,0.08)_40%,transparent_70%)] dark:bg-[radial-gradient(ellipse_70%_50%_at_50%_80%,rgba(30,58,138,0.18),transparent_70%)]"></div>
    </div>

    <!-- Main Content Layer -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <Header />
      <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
